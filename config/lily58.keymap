#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        bt_clr_shift: bt_clr_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&bt BT_CLR>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  GRAVE  |  1  |  2  |  3   |  4   |  5   |                    |  6   |  7   |   8   |  9   |   0   | BSPC  |
            // |  TAB    |  Q  |  W  |  E   |  R   |  T   |                    |  Y   |  U   |   I   |  O   |   P   |   -   |
            // | SHIFT   |  A  |  S  |  D   |  F   |  G   |                    |  H   |  J   |   K   |  L   |   ;   |   '   |
            // |  CTRL   |  Z  |  X  |  C   |  V   |  B   |  [    |    |   ]   |  N   |  M   |   ,   |  .   |   /   | SHIFT |
            //                       | ALT  | GUI  | SYMB | SPACE |    | ENTER | FNAV | GUI  | APP   |

            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                         &kp N6  &kp N7    &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                          &kp Y   &kp U     &kp I      &kp O    &kp P     &kp MINUS
&kp LSHFT  &kp A   &kp S   &kp D     &kp F     &kp G                          &kp H   &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C     &kp V     &kp B   &kp LBKT     &kp RBKT  &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LALT  &kp LGUI  &mo 1   &kp SPACE    &kp RET   &mo 2   &kp RGUI  &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbol_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &   |   *   |  -   |   =   |  DEL   |
            // |       |     |     |      |      |      |                   |      |      |       |  [   |   ]   |   \    |
            // |       |     |     |      |      |      |                   |      |      |       |      |       |        |
            // |       |     |     |      |      |      |        |  |       |      |      |       |      |       |        |
            //                     |      |      |      |        |  |       |      |      |       |

            display-name = "Symbol";
            bindings = <
&kp ESC  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT                    &kp CARET  &kp AMPS  &kp ASTERISK  &kp MINUS  &kp EQUAL  &kp DEL
&trans   &trans    &trans  &trans    &trans    &trans                       &trans     &trans    &trans        &kp LBKT   &kp RBKT   &kp BSLH
&trans   &trans    &trans  &trans    &trans    &trans                       &trans     &trans    &trans        &trans     &trans     &trans
&trans   &trans    &trans  &trans    &trans    &trans     &trans    &trans  &trans     &trans    &trans        &trans     &trans     &trans
                           &trans    &trans    &trans     &trans    &trans  &trans     &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_nav_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  F1   |  F2  |  F3  |  F4  |  F5  |  F6  |                   |  =   |  +   |   \   |  |   |   =   |        |
            // |  F7   |  F8  |  F9  |  F10 |  F11 |  F12 |                   | HOME |      |   UP  |      | PG_UP |   \    |
            // |       |      |      |      |      |      |                   | END  | LEFT |  DOWN | RIGHT| PG_DN |        |
            // |       |      |      |      |      |      |        |  |       |      |      |       |      |       |        |
            //                       |      |      |      |        |  |       |      |      |       |

            display-name = "Fn Nav";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &kp CARET  &kp AMPS  &kp ASTERISK  &kp MINUS  &kp EQUAL  &kp DEL
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12                    &kp HOME   &trans    &kp UP        &trans     &kp PG_UP  &kp BSLH
&trans  &trans  &trans  &trans   &trans   &trans                     &kp END    &kp LEFT  &kp DOWN      &kp RIGHT  &kp PG_DN  &trans
&trans  &trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans     &trans    &trans        &trans     &trans     &trans
                        &trans   &trans   &trans   &trans    &trans  &trans     &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        appcontrol_layer {
            display-name = "AppCtrl";

            // ------------------------------------------------------------------------------------------------------------
            // |       | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   | BRI- | BRI+ |       | VOL- | VOL+  | BT_CLR |
            // |       |     |     |      |      |      |                   |      |  TL  |  Top  |  TR   |      |        |
            // |       |     |     |      |      |      |                   | Prev |  Left| Center| Right| Next  |        |
            // |       |     |     |      |      |      |        |  |       |      |  BL  | Bottom|  BR   |  Max  |        |
            // |                   |      |      |      |        |  |       |      |      |       |

            bindings = <
&out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &kp C_BRI_DN       &kp C_BRI_UP       &trans                 &kp C_VOL_DN         &kp C_VOL_UP          &bt_clr_shift
&trans        &trans        &trans        &trans        &trans        &trans                          &trans             &kp LC(LA(LG(U)))  &kp LC(LA(LG(I)))      &kp LC(LA(LG(O)))    &trans                &trans
&trans        &trans        &trans        &trans        &trans        &trans                          &kp LC(LA(LG(H)))  &kp LC(LA(LG(J)))  &kp LC(LA(LG(K)))      &kp LC(LA(LG(L)))    &kp LC(LA(LG(SEMI)))  &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans             &kp LC(LA(LG(M)))  &kp LC(LA(LG(COMMA)))  &kp LC(LA(LG(DOT)))  &kp LC(LA(LG(FSLH)))  &trans
                                          &trans        &trans        &trans        &trans    &trans  &trans             &trans             &trans
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
